<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net40</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>
    </RootNamespace>
    <AssemblyName>CompuMaster.Data.Outlook</AssemblyName>
    <MyType>Windows</MyType>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <NoWarn>42016,41999,42017,42018,42019,42032,42036,42020,42021,42022,42353,42354,42355</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>2026.11.12.100</Version>
    <Title>CompuMaster.Data.Outlook - MIT license edition</Title>
    <Authors>CompuMaster GmbH</Authors>
    <Copyright>2017,2021,2026 CompuMaster GmbH</Copyright>
    <Description>.NET library with common methods for quick and performant access to Microsoft Outlook .pst files using NetOffice.OutlookApi.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/CompuMasterGmbH/CompuMaster.Data.Outlook</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CompuMasterGmbH/CompuMaster.Data.Outlook.git</RepositoryUrl>
    <PackageIcon>logo_64x64.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>CompuMaster Common Utils Data OutlookApi Outlook Microsoft NetOffice</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetOfficeFw.Outlook" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Data" />
    <Import Include="System.Diagnostics" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="My Project/Application.Designer.vb">
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
    <Compile Update="My Project/Resources1.Designer.vb">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="My Project/Settings1.Designer.vb">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <EmbeddedResource Update="My Project/Resources.resx">
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <SubType>Designer</SubType>
      <LastGenOutput>Resources1.Designer.vb</LastGenOutput>
    </EmbeddedResource>
    <None Update="My Project/Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
    <None Update="My Project/Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <CustomToolNamespace>My</CustomToolNamespace>
      <LastGenOutput>Settings1.Designer.vb</LastGenOutput>
    </None>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../logo_64x64.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
