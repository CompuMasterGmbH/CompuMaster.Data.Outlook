<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>SampleConsoleAppCSharp</RootNamespace>
    <AssemblyName>SampleConsoleAppCSharp</AssemblyName>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CompuMaster.Data" Version="2.8.2020.625" />
    <PackageReference Include="NetOfficeFw.Outlook" Version="1.8.0" />
    <ProjectReference Include="../CompuMaster.Data.Outlook/CompuMaster.Data.Outlook.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="SampleData/Mailbox.pst" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
